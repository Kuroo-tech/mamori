    <string name="protection_title">Protection</string>
    <string name="automatic_protection">Automatic protection</string>
    <string name="automatic_protection_summary">Event-driven monitoring of only the FCM whitelist key. A non-waking 30-minute fallback check is used only as insurance.</string>
    <string name="persistent_notification">Persistent notification</string>
    <string name="persistent_notification_summary">Recommended ON for maximum reliability. Turn it OFF to remove the ongoing notification and use background-only mode; HyperOS may then stop the service more easily.</string>
    <string name="actions_title">Tools</string>
    <string name="advanced_title">Advanced configuration</string>

    <string name="helper_text">Low-power design: the service no longer polls every 30 seconds, no longer watches unrelated system settings, and only sends an FCM reconnect request after an actual whitelist repair.</string>
    <string name="note_text">Recommended on HyperOS: keep Autostart enabled and battery mode set to No restrictions. Developer options, USB debugging and Wireless debugging are not required.</string>

